# Python 后端环境变量（与 Node 版契约一致）
# 复制为 .env 并按需修改；不要在仓库里提交真实的 .env

# 监听端口。刻意与 Node 版（3001）不同，两套后端可以同时启动、并行对比
PORT=8000

# SQLite 数据库文件。
# 留空时默认指向 Node 版使用的同一个文件（../server/data.db），两套后端共用一份数据；
# 想让 Python 版独立跑一份数据时，指向别的路径即可。
DB_PATH=

# JWT 签名密钥。⚠️ 上线必须换成随机串，否则任何人可伪造令牌
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=park-ops-demo-secret

# 置为 1 时把 token 校验失败的具体原因写入日志，用于排查部署环境差异
API_DEBUG=0
