    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2",
